DATABASE_URL=postgresql://user:password@localhost:5432/elearning
JWT_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=uploads

# Student knowledge chat uses V2 by default; false restores legacy behavior.
RAG_V2_ENABLED=true
# Installed Qwen model used in the isolated validated RAG V2 evaluation.
RAG_V2_OLLAMA_MODEL=qwen2.5-coder:7b
